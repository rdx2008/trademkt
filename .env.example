APP_NAME="Trade Promo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://painel.seudominio.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

# Domínios do painel central (fornecedor), separados por vírgula
CENTRAL_DOMAINS=painel.seudominio.com.br
TRADE_ESQUEMA_URL=https

# Super admin criado no primeiro deploy (db:seed)
SUPER_ADMIN_NOME="Rodolfo"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_SENHA=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Banco central. O usuário precisa poder criar bancos com prefixo cli_
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=trade_central
DB_USERNAME=trade
DB_PASSWORD=
TENANT_DB_PREFIX=cli_

# Sessão, cache e filas no Redis (o cache precisa suportar tags)
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Arquivos: hoje disco local (storage/clientes/<id>).
# Para storage externo S3 compatível (AWS, R2, Wasabi, B2, MinIO), preencha abaixo.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Geocoding do endereço do PDV (Google). Sem chave, as coordenadas são ajustadas no mapa.
GOOGLE_MAPS_API_KEY=

# Importador de catálogo (fase 2)
OPENAI_API_KEY=

# docker-compose (MySQL)
MYSQL_ROOT_PASSWORD=
